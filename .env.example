# Required for "import image -> editable whiteboard". Server-side only: never prefix with VITE_.
GEMINI_API_KEY=
# Optional
GEMINI_MODEL=gemini-2.5-flash
# Max AI conversions per IP per 10 minutes (best effort on serverless)
CONVERT_RATE_LIMIT=10
# Extra origins allowed to call the API, comma-separated (your own domain is always allowed)
ALLOWED_ORIGINS=
